# SkillCraft Micro-Jobs: Environment Configuration Template
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://skillcraft_user:skillcraft_password@localhost:5432/skillcraft
# For Docker, use: DATABASE_URL=postgresql://skillcraft_user:skillcraft_password@postgres:5432/skillcraft

DB_HOST=localhost
DB_PORT=5432
DB_NAME=skillcraft
DB_USER=skillcraft_user
DB_PASSWORD=skillcraft_password

# Test Database (for Jest tests)
TEST_DB_NAME=skillcraft_test
TEST_DB_USER=skillcraft_user
TEST_DB_PASSWORD=skillcraft_password

# Server Configuration
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# Logging
LOG_LEVEL=debug

# CORS Configuration (optional)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
